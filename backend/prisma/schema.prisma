generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String   @default("user")
  password  String?
}

model Cpu {
  id          BigInt   @id
  code        String
  acquisition String
  isAuditen   Boolean  @default(false)
  location    String
}

model Room {
  id          Int      @id
  name        String   @unique
  capacity    Int
  paStatus    Json
}

model HeadsetStock {
  id          BigInt   @id
  brand       String   @unique
  quantity    Int      @default(0)
}

model HeadsetDefect {
  id          BigInt   @id
  date        DateTime @default(now())
  returnDate  DateTime?
  brand       String
  defect      String
  status      String
  box         String
}

model History {
  id          BigInt   @id
  date        DateTime @default(now())
  action      String?
  cpuCode     String?
  from        String?
  to          String?
  brand       String?
  qty         Int?
  details     String?
}

model HeadsetHistory {
  id          BigInt   @id
  date        DateTime @default(now())
  action      String
  brand       String
  qty         Int
  details     String?
}
